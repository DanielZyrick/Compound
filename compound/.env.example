# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# PostgreSQL (Neon via Vercel). Get both with: npx vercel env pull .env.local
# Pooled connection, used by the app
DATABASE_URL=
# Direct connection, used by migrations
DATABASE_URL_UNPOOLED=

# Auth.js secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# GitHub OAuth app (github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Claude API (server-side only)
ANTHROPIC_API_KEY=
MODEL_FAST=
MODEL_SMART=
