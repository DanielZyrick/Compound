# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# PostgreSQL (Neon). Locally, use your Neon "dev" branch: Connect > Branch: dev.
# Do not run `vercel env pull`: it overwrites .env.local. See README.md.
# Pooled connection, used by the app
DATABASE_URL=
# Direct connection, used by migrations
DATABASE_URL_UNPOOLED=

# Auth.js secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# GitHub OAuth app (github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Claude API (server-side only)
ANTHROPIC_API_KEY=
MODEL_FAST=
MODEL_SMART=
# Optional: 1 uses example content instead of calling Claude (also the
# default when ANTHROPIC_API_KEY is empty).
AI_DEMO_MODE=

# End-to-end tests (npm run test:e2e) refuse to run unless DATABASE_URL
# points at this host. Set it to your dev branch host, never production.
E2E_DB_HOST=
